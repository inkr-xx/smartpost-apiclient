{
  "name": "inkr/smartpost-apiclient",
  "version": "2.0.1",
  "description": "Itella SmartPost API client",
  "type": "library",
  "authors": [
    {
      "name": "Indrek Kriisa",
      "email": "indrek.kriisa@gmail.com"
    }
  ],
  "license": [
    "MIT"
  ],
  "require": {
    "php": ">=8.0 <8.6",
    "ext-curl": "*"
  },
  "autoload": {
    "psr-4": {
      "inkr\\SmartPost\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit --bootstrap tests/bootstrap.php tests"
  }
}
